{
  "name": "openlines-ai-bot",
  "version": "1.0.0",
  "description": "Bot de IA para Canais Abertos do Bitrix24 (Desenvolvendo Personalidade) usando a API da OpenAI",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.js",
    "test": "node --test test/*.test.js",
    "preview": "node --env-file-if-exists=.env.preview src/main.js",
    "registrar": "node --env-file-if-exists=.env scripts/registrar-bot.js"
  }
}
